<span class="stars">
    @for (var i = 1; i <= 5; i++)
    {
        <svg class="@(i <= Math.Round(Rating) ? "f" : "e")" width="14" height="14"><use href="#i-star" /></svg>
    }
    @if (!string.IsNullOrEmpty(Label))
    {
        <b>@Label</b>
    }
</span>

@code {
    [Parameter] public double Rating { get; set; }
    [Parameter] public string Label { get; set; } = "";
}
